# Optional Supabase configuration.
# The current quotation app uses browser storage and deploys without these values.
# Add them only when enabling Supabase-backed authentication or server functions.
# Use the publishable/anon key only. Never put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_ID=your-project-id
