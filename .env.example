# Optional Supabase configuration for future auth or server-side features.
# The current app stores quotations in browser localStorage and does not require
# these values for normal Vercel deployment.
# Use the publishable/anon key only in client-side VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side or admin Supabase configuration.
# Keep these in local .env files only and add them manually in Vercel when needed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Optional cron-protected automation secrets.
CRON_SECRET=replace-with-a-long-random-secret
CRON_SECRET_PREVIOUS=replace-with-an-older-secret-if-rotating
